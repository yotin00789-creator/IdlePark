# --- Database (Postgres). Leave empty for local use: an embedded database is created in .data/
# On Vercel use a Neon / Vercel Postgres pooled connection string.
DATABASE_URL=

# --- Secrets (required in production, at least 16 characters; generate with: openssl rand -base64 32)
SESSION_SECRET=
MFA_ENC_KEY=

# --- Public address of the site (used in email links)
APP_URL=http://localhost:5173
APP_NAME=IdlePark

# --- Gmail SMTP: turn on 2-step verification, then create an "App password"
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM="IdlePark" <yourname@gmail.com>

# --- Vercel Cron calls /api/cron/reminders with this value as a Bearer token
CRON_SECRET=
